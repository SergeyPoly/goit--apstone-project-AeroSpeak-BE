// AeroSpeak database schema.
// Scenarios are NOT stored here: they live as JSON files in /content and are
// validated at startup. The database holds only user data: users and their attempts.
// Pilot audio is never stored, only the transcript and the scoring result.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon pooled connection (app runtime)
  url       = env("DATABASE_URL")
  // Neon direct connection (migrations)
  directUrl = env("DIRECT_URL")
}

// Identity lives in Firebase Authentication; this row holds our own profile data.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  firebaseUid     String    @unique
  // Copied from the Firebase ID token. Not unique: after deleting the Firebase account
  // the same email can sign up again and gets a new uid.
  email           String?
  name            String?
  emailVerified   Boolean   @default(false)
  termsAcceptedAt DateTime?
  voiceConsentAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  attempts        Attempt[]

  @@index([email])
}

model Attempt {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  packId     String
  scenarioId String
  stepId     String
  // One pass through a scenario, generated by the frontend. Null on attempts made before runs.
  sessionId  String? @db.Uuid

  transcript            String
  sttConfidence         Float?
  score                 Int
  displayScore          Int
  success               Boolean
  missedCritical        String[]
  // Per-element results (status, similarity) as returned by the scoring engine.
  elements              Json
  // Feedback as shown to the user, kept so the history can reopen it after content changes.
  // Null on attempts saved before these columns; order is also null when there was nothing to compare.
  expectedPilotResponse String?
  tip                   String?
  order                 Json?
  processingMs          Int

  @@index([userId, createdAt])
  @@index([userId, scenarioId, createdAt])
  @@index([scenarioId])
}
