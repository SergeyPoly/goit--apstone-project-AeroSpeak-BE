# Server
PORT=3000
NODE_ENV=development

# Neon PostgreSQL
# Pooled connection string (host contains "-pooler"), used by the app
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/aerospeak?sslmode=require"
# Direct connection string (no "-pooler"), used by Prisma migrations
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/aerospeak?sslmode=require"

# Speech-to-text (Deepgram)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
# Optional regex for Vercel preview deployments, e.g. ^https://aerospeak-.*\.vercel\.app$
CORS_ORIGIN_REGEX=

# Proxies in front of the app: 1 on Render, 0 when running without a proxy.
# Rate limits are per client IP, read from X-Forwarded-For this many hops from the right.
TRUST_PROXY_HOPS=1
