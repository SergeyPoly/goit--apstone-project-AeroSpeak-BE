{
  "id": "alphabet-letters-i-q",
  "title": "Letters I–Q",
  "packId": "basics-alphabet",
  "difficulty": "easy",
  "estimatedDurationSec": 135,
  "objective": "Say the letters I–Q with the ICAO phonetic alphabet.",
  "phraseologyNote": {
    "id": "alphabet-i-q",
    "title": "Phonetic alphabet, I–Q",
    "shortExplanation": "India, Juliett, Kilo, Lima, Mike, November, Oscar, Papa, Quebec.",
    "overview": [
      "The stress is part of the word: IN-dee-ah, JEW-lee-ETT, KEY-loh, LEE-mah, MIKE, no-VEM-ber, OSS-cah, pah-PAH, keh-BECK.",
      "Many ATIS letters and VFR points use this part of the alphabet, so you will hear these words in almost every flight."
    ],
    "whyItMatters": "A misheard letter can send you to the wrong taxiway or the wrong reporting point.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.3 Transmission of letters"
      }
    ]
  },
