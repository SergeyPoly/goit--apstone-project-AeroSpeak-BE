{
  "id": "basic-more-standard-words",
  "title": "Roger, negative, unable, standby",
  "packId": "basics-standard-words",
  "variants": {
    "aircraft": true
  },
  "difficulty": "easy",
  "estimatedDurationSec": 120,
  "objective": "Answer ATC with roger, negative, unable and standby.",
  "briefing": [
    {
      "label": "Callsign",
      "value": "{{callsign}}"
    },
    {
      "label": "Aircraft",
      "value": "{{aircraft}}"
    }
  ],
  "phraseologyNote": {
    "id": "more-standard-words",
    "title": "Roger, negative, unable, standby",
    "shortExplanation": "Roger = message received. Negative = no. Unable = I cannot comply. Standby = wait, I will call you back.",
    "overview": [
      "ROGER only means that you received the message. It is never the answer to a question, and it does not replace a readback.",
      "UNABLE means you cannot comply; give the reason if you can. STANDBY means wait, you will call back; it is neither yes nor no.",
      "After NEGATIVE, give the correct information."
    ],
    "whyItMatters": "Unable is the safe answer when an instruction conflicts with VFR or aircraft limits.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.6 Standard words and phrases"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.3 Issue of clearance and read-back requirements"
      }
    ]
  },
  "steps": [
