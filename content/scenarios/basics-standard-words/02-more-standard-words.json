      "id": "roger",
      "type": "basic_drill",
      "speaker": "atc",
      "prompt": "ATC gives you wind information. Acknowledge it.",
      "atcText": "{{callsign}}, wind 270 degrees 10 knots.",
      "expectedPilotResponse": "Roger, {{callsign}}.",
      "requiredElements": [
        {
          "id": "roger",
          "label": "Roger",
          "acceptedVariants": [
            "roger"
          ],
          "weight": 60
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 40
        }
      ]
    },
    {
