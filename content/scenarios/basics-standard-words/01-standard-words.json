{
  "id": "basic-standard-words",
  "title": "Standard words",
  "packId": "basics-standard-words",
  "difficulty": "easy",
  "estimatedDurationSec": 90,
  "objective": "Answer short ATC calls with the right standard word and your callsign.",
  "briefing": [
    {
      "label": "Callsign",
      "value": "SP-TFA"
    },
    {
      "label": "Aircraft",
      "value": "Cessna 172"
    }
  ],
  "phraseologyNote": {
    "id": "standard-words",
    "title": "Standard words",
    "shortExplanation": "Wilco = I understand and will comply. Affirm = yes. Negative = no. Roger = I received your message.",
    "overview": [
      "Standard words have one fixed meaning, so a short answer cannot be misread.",
      "WILCO already includes ROGER, so the two are never said together. AFFIRM means yes; NEGATIVE means no.",
      "End each answer with your callsign so ATC knows who answered."
    ],
    "whyItMatters": "Standard words keep transmissions short and unambiguous.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.6 Standard words and phrases"
      }
    ]
  },
  "steps": [
    {
      "id": "wilco",
      "type": "basic_drill",
      "speaker": "atc",
      "prompt": "ATC asks you to report when ready. Answer that you will comply.",
      "atcText": "SP-TFA, report ready for departure.",
      "atcAudio": "/audio/atc/basic-standard-words/wilco.mp3",
      "expectedPilotResponse": "Wilco, SP-TFA.",
      "requiredElements": [
        {
          "id": "wilco",
          "label": "Wilco",
          "acceptedVariants": [
            "wilco"
          ],
          "weight": 60
        },
        {
          "id": "callsign",
          "label": "SP-TFA",
          "acceptedVariants": [
            "SP-TFA",
            "Sierra Papa Tango Foxtrot Alpha"
          ],
          "weight": 40
        }
      ]
    },
    {
      "id": "affirm",
      "type": "basic_drill",
      "speaker": "atc",
      "prompt": "ATC wants to confirm your flight rules. You are VFR: answer yes.",
      "atcText": "SP-TFA, confirm you are VFR.",
      "atcAudio": "/audio/atc/basic-standard-words/affirm.mp3",
      "expectedPilotResponse": "Affirm, SP-TFA.",
      "requiredElements": [
        {
          "id": "affirm",
          "label": "Affirm",
          "acceptedVariants": [
            "affirm"
