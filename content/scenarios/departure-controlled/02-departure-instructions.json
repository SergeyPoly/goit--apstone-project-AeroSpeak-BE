      "EPPO"
    ],
    "to": [
      "EPPI"
    ],
    "weather": true,
    "aircraft": true
  },
  "difficulty": "hard",
  "estimatedDurationSec": 120,
  "objective": "Read back the departure route with an altitude restriction and the frequency change.",
  "briefing": [
    {
      "label": "Airport",
      "value": "{{airport}}"
    },
    {
      "label": "Station",
      "value": "{{tower}} {{tower.freq}}"
    },
    {
      "label": "Callsign",
      "value": "{{callsign}}"
    },
    {
      "label": "Aircraft",
      "value": "{{aircraft}}"
    },
    {
      "label": "Runway",
      "value": "{{runway}}"
    },
    {
      "label": "Wind",
      "value": "{{wind.brief}}"
    },
    {
      "label": "Intention",
      "value": "VFR to {{departure.to}} via {{departure.exit}}"
    }
  ],
  "phraseologyNote": {
    "id": "departure-instructions",
    "title": "VFR departure instructions",
    "shortExplanation": "Read back the turn, the exit point, the altitude limit and the new frequency.",
    "overview": [
      "Tower gives the VFR departure route: which way to turn after take-off, the exit point of the control zone and an altitude limit. Read back all of it; the altitude limit is a level instruction.",
      "When you are handed over, read back the station and the frequency before you change. Without an instruction, tell the station before you leave its frequency."
    ],
    "whyItMatters": "VFR exit routes keep departures clear of arrivals and of IFR traffic.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "7.2 VFR departures"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.2 Transfer of communications"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.3 Issue of clearance and read-back requirements"
      },
      {
        "source": "{{chart.source}}",
        "section": "{{chart.section}}",
        "url": "{{chart.url}}"
      }
    ]
  },
  "steps": [
    {
      "id": "route-readback",
      "type": "pilot_readback",
      "speaker": "atc",
      "prompt": "Tower gives you the departure route. Read it back.",
      "atcText": "{{callsign}}, {{tower}}, after departure turn {{runway.departureTurn}}, leave control zone via {{departure.exit}}, not above altitude {{departure.altitude}} feet.",
      "expectedPilotResponse": "After departure turn {{runway.departureTurn}}, leave control zone via {{departure.exit}}, not above altitude {{departure.altitude}} feet, {{callsign}}.",
      "requiredElements": [
        {
          "id": "turn",
          "label": "After departure turn {{runway.departureTurn}}",
          "acceptedVariants": [
            "after departure turn {{runway.departureTurn}}",
            "turn {{runway.departureTurn}}"
          ],
          "weight": 20,
          "critical": true
        },
        {
          "id": "exit",
          "label": "Leave control zone via {{departure.exit}}",
          "acceptedVariants": [
            "leave control zone via {{departure.exit}}",
            "leaving control zone via {{departure.exit}}",
            "via {{departure.exit}}"
          ],
          "weight": 30,
          "critical": true
        },
        {
          "id": "altitude",
          "label": "Not above altitude {{departure.altitude}} feet",
          "acceptedVariants": [
            "not above [altitude] {{departure.altitude}} feet"
          ],
          "weight": 30,
          "critical": true
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 20,
          "critical": true
        }
      ],
      "criticalElements": [
        "turn",
        "exit",
        "altitude",
        "callsign"
      ]
    },
    {
      "id": "frequency-readback",
      "type": "pilot_readback",
      "speaker": "atc",
      "prompt": "Approaching {{departure.exit}}, Tower hands you over. Read back.",
      "atcText": "{{callsign}}, contact {{approach}} {{approach.freq}}.",
      "expectedPilotResponse": "Contact {{approach}} {{approach.freq}}, {{callsign}}.",
      "requiredElements": [
        {
          "id": "contact",
          "label": "Contact {{approach}}",
          "acceptedVariants": [
            "contact {{approach}}",
            "contact Approach"
          ],
          "weight": 30
        },
        {
          "id": "frequency",
          "label": "{{approach.freq}}",
          "acceptedVariants": [
            "{{approach.freq}}"
          ],
          "weight": 45,
          "critical": true
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 25,
          "critical": true
        }
      ],
      "criticalElements": [
        "frequency",
        "callsign"
      ],
      "visual": {
        "kind": "airspace",
        "point": "{{departure.exit}}",
        "direction": "outbound"
      }
    }
  ]
