  "phraseologyNote": {
    "id": "take-off-clearance",
    "title": "Take-off clearance",
    "shortExplanation": "Read back the runway and \"cleared for take-off\". Wind does not need a readback.",
    "overview": [
      "Report ready only when you are at the holding point and ready to go. \"Line up and wait\" lets you enter the runway, but not take off.",
      "The words \"take off\" are used only in a take-off clearance or to cancel one. Elsewhere ATC and pilots say \"departure\".",
      "Every runway clearance is read back: line up, take off, land, cross, hold short, backtrack."
    ],
    "whyItMatters": "A take-off clearance readback without the runway is incomplete.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "4.5 Take-off procedures"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.3 Issue of clearance and read-back requirements"
      }
    ]
  },
  "steps": [
    {
      "id": "ready",
      "type": "pilot_request",
      "speaker": "pilot",
      "prompt": "You are at the holding point of runway {{runway}}, checks complete. Tell Tower you are ready.",
      "expectedPilotResponse": "{{tower}}, {{callsign}}, holding point runway {{runway}}, ready for departure.",
      "requiredElements": [
        {
          "id": "station",
          "label": "{{tower}}",
          "acceptedVariants": [
            "{{tower}}"
          ],
          "weight": 10
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 20
        },
        {
          "id": "holding_point",
          "label": "Holding point runway {{runway}}",
          "acceptedVariants": [
