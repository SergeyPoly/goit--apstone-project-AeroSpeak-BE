  "phraseologyNote": {
    "id": "fis-initial-call",
    "title": "Initial call to FIS",
    "shortExplanation": "Station, callsign, flight rules and route, position, altitude. FIS knows what you need from the call itself.",
    "example": "Poznań Information, SP-TFA, VFR from Piła to Poznań, 10 miles south of Piła, altitude 2500 feet.",
    "whyItMatters": "FIS can only help (traffic, weather) if it knows who and where you are."
  },
  "steps": [
    {
      "id": "initial-call",
      "type": "pilot_request",
      "speaker": "pilot",
      "prompt": "You are 10 miles south of Piła at 2500 feet, flying VFR to Poznań. Make the initial call to Poznań Information.",
      "expectedPilotResponse": "Poznań Information, SP-TFA, VFR from Piła to Poznań, 10 miles south of Piła, altitude 2500 feet.",
      "requiredElements": [
        {
          "id": "station",
          "label": "Poznań Information",
          "acceptedVariants": [
            "Poznań Information",
            "Poznan Information"
          ],
          "weight": 10
        },
        {
          "id": "callsign",
          "label": "SP-TFA",
          "acceptedVariants": [
            "SP-TFA",
            "Sierra Papa Tango Foxtrot Alpha"
          ],
          "weight": 25
        },
        {
          "id": "route",
          "label": "VFR from Piła to Poznań",
          "acceptedVariants": [
            "VFR from Piła to Poznań",
            "VFR from Pila to Poznan",
            "from Piła to Poznań",
            "from Pila to Poznan"
          ],
          "weight": 25
        },
        {
          "id": "position",
          "label": "10 miles south of Piła",
          "acceptedVariants": [
            "10 miles south of Piła",
            "10 miles south of Pila"
          ],
          "weight": 20
        },
        {
          "id": "altitude",
          "label": "Altitude 2500 feet",
          "acceptedVariants": [
            "[altitude] 2500 feet"
          ],
          "weight": 20
        }
      ]
    },
    {
      "id": "squawk-readback",
      "type": "pilot_readback",
      "speaker": "atc",
      "prompt": "FIS identifies you. Read back squawk and QNH.",
      "atcText": "SP-TFA, Poznań Information, flight information service, squawk 5201, QNH 1013.",
      "atcAudio": "/audio/atc/fis-initial-call/squawk-readback.mp3",
      "expectedPilotResponse": "Squawk 5201, QNH 1013, SP-TFA.",
      "requiredElements": [
        {
          "id": "squawk",
          "label": "Squawk 5201",
          "acceptedVariants": [
            "squawk 5201"
          ],
          "weight": 40,
          "critical": true
        },
        {
          "id": "qnh",
          "label": "QNH 1013",
          "acceptedVariants": [
            "QNH 1013"
          ],
          "weight": 35,
          "critical": true
        },
        {
          "id": "callsign",
          "label": "SP-TFA",
          "acceptedVariants": [
            "SP-TFA",
            "Sierra Papa Tango Foxtrot Alpha"
          ],
          "weight": 25,
          "critical": true
        }
      ],
      "criticalElements": [
        "squawk",
        "qnh",
        "callsign"
      ]
    }
  ]
}
