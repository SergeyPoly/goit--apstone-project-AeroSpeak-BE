{
  "id": "fis-initial-call",
  "title": "Initial call to FIS",
  "packId": "enroute-fis",
  "variants": {
    "aerodromes": [
      "EPPI"
    ],
    "to": [
      "EPPO"
    ],
    "weather": true,
    "aircraft": true
  },
  "difficulty": "medium",
  "estimatedDurationSec": 120,
  "objective": "Make the initial call to FIS and read back the squawk and QNH.",
  "briefing": [
    {
      "label": "Airport",
      "value": "{{airport}}"
    },
    {
      "label": "Station",
      "value": "{{information}} {{information.freq}}"
    },
    {
      "label": "Callsign",
      "value": "{{callsign}}"
    },
    {
      "label": "Aircraft",
      "value": "{{aircraft}}"
    },
    {
      "label": "Position",
      "value": "{{departure.exit}} ({{departure.exit.location}} of {{city}})"
    },
    {
      "label": "Altitude",
      "value": "2500 feet"
    },
    {
      "label": "Intention",
      "value": "VFR {{city}} to {{departure.to}}"
    }
  ],
  "phraseologyNote": {
    "id": "fis-initial-call",
    "title": "Initial call to FIS",
    "shortExplanation": "Station, callsign, flight rules and route, position, altitude. FIS knows what you need from the call itself.",
    "overview": [
      "FIS (flight information service) gives information and alerting service but does not separate VFR traffic. In Poland its stations are called \"Information\".",
      "Make the first call with full callsigns, flight rules and route, position and altitude.",
      "FIS usually gives a squawk and the QNH. Both are always read back."
    ],
    "whyItMatters": "FIS can only help (traffic, weather) if it knows who and where you are.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.1 Establishment and continuation of communication"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "3.4 Position reporting"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.3 Issue of clearance and read-back requirements"
      }
    ]
  },
  "steps": [
    {
      "id": "initial-call",
      "type": "pilot_request",
      "speaker": "pilot",
      "prompt": "You are over {{departure.exit}}, {{departure.exit.location}} of {{city}}, at 2500 feet, flying VFR to {{departure.to}}. Make the initial call to {{information}}.",
      "expectedPilotResponse": "{{information}}, {{callsign}}, VFR from {{city}} to {{departure.to}}, overhead {{departure.exit}}, altitude 2500 feet.",
      "requiredElements": [
        {
          "id": "station",
          "label": "{{information}}",
          "acceptedVariants": [
            "{{information}}"
          ],
          "weight": 10
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 25
        },
        {
          "id": "route",
          "label": "VFR from {{city}} to {{departure.to}}",
          "acceptedVariants": [
            "VFR from {{city}} to {{departure.to}}",
            "from {{city}} to {{departure.to}}"
          ],
          "weight": 25
        },
        {
          "id": "position",
          "label": "Overhead {{departure.exit}}",
          "acceptedVariants": [
            "overhead {{departure.exit}}",
            "over {{departure.exit}}"
          ],
          "weight": 20
        },
        {
          "id": "altitude",
          "label": "Altitude 2500 feet",
          "acceptedVariants": [
            "[altitude] 2500 feet"
          ],
          "weight": 20
        }
      ]
    },
    {
      "id": "squawk-readback",
      "type": "pilot_readback",
      "speaker": "atc",
      "prompt": "FIS identifies you. Read back squawk and QNH.",
      "atcText": "{{callsign}}, {{information}}, flight information service, squawk 5201, QNH {{qnh}}.",
      "expectedPilotResponse": "Squawk 5201, QNH {{qnh}}, {{callsign}}.",
      "requiredElements": [
        {
          "id": "squawk",
          "label": "Squawk 5201",
          "acceptedVariants": [
            "squawk 5201"
          ],
          "weight": 40,
          "critical": true
        },
        {
          "id": "qnh",
          "label": "QNH {{qnh}}",
          "acceptedVariants": [
            "QNH {{qnh}}"
          ],
          "weight": 35,
          "critical": true
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 25,
          "critical": true
        }
      ],
      "criticalElements": [
        "squawk",
        "qnh",
        "callsign"
      ]
    }
  ]
}
