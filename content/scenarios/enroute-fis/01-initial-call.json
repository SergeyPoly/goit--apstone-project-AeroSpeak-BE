  "phraseologyNote": {
    "id": "fis-initial-call",
    "title": "Initial call to FIS",
    "shortExplanation": "Station, callsign, flight rules and route, position, altitude. FIS knows what you need from the call itself.",
    "overview": [
      "FIS (flight information service) gives information and alerting service but does not separate VFR traffic. In Poland its stations are called \"Information\".",
      "Make the first call with full callsigns, flight rules and route, position and altitude.",
      "FIS usually gives a squawk and the QNH. Both are always read back."
    ],
    "whyItMatters": "FIS can only help (traffic, weather) if it knows who and where you are.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.1 Establishment and continuation of communication"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "3.4 Position reporting"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.3 Issue of clearance and read-back requirements"
      }
    ]
  },
  "steps": [
    {
      "id": "initial-call",
      "type": "pilot_request",
      "speaker": "pilot",
      "prompt": "You are over Kilo, south-west of Piła, at 2500 feet, flying VFR to Poznań. Make the initial call to Poznań Information.",
      "expectedPilotResponse": "Poznań Information, SP-TFA, VFR from Piła to Poznań, overhead Kilo, altitude 2500 feet.",
      "requiredElements": [
        {
          "id": "station",
          "label": "Poznań Information",
          "acceptedVariants": [
            "Poznań Information",
            "Poznan Information"
          ],
          "weight": 10
        },
        {
          "id": "callsign",
          "label": "SP-TFA",
          "acceptedVariants": [
            "SP-TFA",
            "Sierra Papa Tango Foxtrot Alpha"
          ],
          "weight": 25
        },
        {
          "id": "route",
          "label": "VFR from Piła to Poznań",
          "acceptedVariants": [
            "VFR from Piła to Poznań",
            "VFR from Pila to Poznan",
            "from Piła to Poznań",
            "from Pila to Poznan"
          ],
          "weight": 25
        },
        {
          "id": "position",
          "label": "Overhead Kilo",
          "acceptedVariants": [
            "overhead Kilo",
            "over Kilo"
          ],
          "weight": 20
        },
        {
          "id": "altitude",
          "label": "Altitude 2500 feet",
          "acceptedVariants": [
            "[altitude] 2500 feet"
          ],
          "weight": 20
        }
      ]
    },
    {
      "id": "squawk-readback",
      "type": "pilot_readback",
      "speaker": "atc",
      "prompt": "FIS identifies you. Read back squawk and QNH.",
      "atcText": "SP-TFA, Poznań Information, flight information service, squawk 5201, QNH 1013.",
      "atcAudio": "/audio/atc/fis-initial-call/squawk-readback.mp3",
      "expectedPilotResponse": "Squawk 5201, QNH 1013, SP-TFA.",
      "requiredElements": [
        {
          "id": "squawk",
          "label": "Squawk 5201",
          "acceptedVariants": [
            "squawk 5201"
          ],
          "weight": 40,
          "critical": true
        },
        {
          "id": "qnh",
          "label": "QNH 1013",
          "acceptedVariants": [
            "QNH 1013"
          ],
          "weight": 35,
          "critical": true
        },
        {
          "id": "callsign",
          "label": "SP-TFA",
          "acceptedVariants": [
            "SP-TFA",
            "Sierra Papa Tango Foxtrot Alpha"
          ],
          "weight": 25,
          "critical": true
        }
      ],
      "criticalElements": [
        "squawk",
        "qnh",
        "callsign"
      ]
    }
  ]
}
