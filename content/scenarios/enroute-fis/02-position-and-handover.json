{
  "id": "fis-position-handover",
  "title": "Position report and handover",
  "packId": "enroute-fis",
  "variants": {
    "aerodromes": [
      "EPPO"
    ],
    "from": [
      "EPPI"
    ],
    "weather": true,
    "aircraft": true
  },
  "difficulty": "medium",
  "estimatedDurationSec": 90,
  "objective": "Give a position report and read back the frequency change to Approach.",
  "briefing": [
    {
      "label": "Airport",
      "value": "{{airport}}"
    },
    {
      "label": "Station",
      "value": "{{information}} {{information.freq}}"
    },
    {
      "label": "Callsign",
      "value": "{{callsign}}"
    },
    {
      "label": "Aircraft",
      "value": "{{aircraft}}"
    },
    {
      "label": "Position",
      "value": "Over {{arrival.waypoint}}"
    },
    {
      "label": "Altitude",
      "value": "2500 feet"
    }
  ],
  "phraseologyNote": {
    "id": "position-report",
    "title": "Position reports and handover",
    "shortExplanation": "Report your position when asked; read back a frequency change before you switch.",
    "overview": [
      "A position report starts with your callsign, then the position and the level. Doc 9432 also lists time and next position, which may be left out where prescribed.",
      "When FIS hands you over, read back the station and the frequency. On the new frequency, call with full callsigns and your level."
    ],
    "whyItMatters": "Position reports are how FIS knows where to look for you if something goes wrong.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "3.4 Position reporting"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.2 Transfer of communications"
      }
    ]
  },
  "steps": [
    {
      "id": "position-report",
      "type": "atc_instruction",
      "speaker": "atc",
      "prompt": "FIS asked you to report over {{arrival.waypoint}}. You are overhead now at 2500 feet.",
      "atcText": "{{callsign}}, {{information}}, report over {{arrival.waypoint}}.",
      "expectedPilotResponse": "{{callsign}}, over {{arrival.waypoint}}, altitude 2500 feet.",
      "requiredElements": [
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 30
        },
        {
          "id": "position",
          "label": "Over {{arrival.waypoint}}",
          "acceptedVariants": [
            "over {{arrival.waypoint}}",
            "overhead {{arrival.waypoint}}",
            "{{arrival.waypoint}}"
          ],
          "weight": 40
        },
        {
          "id": "altitude",
          "label": "Altitude 2500 feet",
          "acceptedVariants": [
            "[altitude] 2500 feet"
          ],
          "weight": 30
        }
      ]
    },
    {
      "id": "handover-readback",
      "type": "pilot_readback",
      "speaker": "atc",
      "prompt": "FIS hands you over to {{approach}}. Read back.",
      "atcText": "{{callsign}}, contact {{approach}} {{approach.freq}}.",
      "expectedPilotResponse": "Contact {{approach}} {{approach.freq}}, {{callsign}}.",
      "requiredElements": [
        {
          "id": "contact",
          "label": "Contact {{approach}}",
          "acceptedVariants": [
            "contact {{approach}}",
            "contact Approach"
          ],
          "weight": 30
        },
        {
          "id": "frequency",
          "label": "{{approach.freq}}",
          "acceptedVariants": [
            "{{approach.freq}}"
          ],
          "weight": 45,
          "critical": true
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 25,
          "critical": true
        }
      ],
      "criticalElements": [
        "frequency",
        "callsign"
      ]
    }
  ]
}
