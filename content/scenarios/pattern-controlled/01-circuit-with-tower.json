{
  "id": "pattern-ctrl-circuit",
  "title": "Circuit with Tower",
  "packId": "pattern-controlled",
  "variants": {
    "aerodromes": [
      "EPPO"
    ],
    "weather": true,
    "aircraft": true
  },
  "difficulty": "medium",
  "estimatedDurationSec": 150,
  "objective": "Fly a circuit with Tower: take-off clearance, downwind report, sequencing and touch-and-go clearance.",
  "briefing": [
    {
      "label": "Airport",
      "value": "{{airport}}"
    },
    {
      "label": "Station",
      "value": "{{tower}} {{tower.freq}}"
    },
    {
      "label": "Callsign",
      "value": "{{callsign}}"
    },
    {
      "label": "Aircraft",
      "value": "{{aircraft}}"
    },
    {
      "label": "Runway",
      "value": "{{runway}}"
    },
    {
      "label": "Wind",
      "value": "{{wind.brief}}"
    },
    {
      "label": "Intention",
      "value": "Circuits, touch-and-go"
    }
  ],
  "phraseologyNote": {
    "id": "circuit-tower",
    "title": "Circuits at a controlled aerodrome",
    "shortExplanation": "Tower sequences you in the circuit. Read back clearances and \"number two\" sequencing; report where you are asked to.",
    "overview": [
      "Tower sequences the circuit traffic. \"Number two\" means one aircraft lands before you; follow it and report it in sight.",
      "Report downwind with your intention, so Tower can plan the next clearance.",
      "Read back a touch-and-go clearance like a landing clearance: runway and clearance."
    ],
    "whyItMatters": "Sequencing keeps aircraft in the circuit separated.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "4.6 Aerodrome traffic circuit"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "4.7 Final approach and landing"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.3 Issue of clearance and read-back requirements"
      }
    ]
  },
  "steps": [
    {
      "id": "take-off-readback",
      "type": "pilot_readback",
      "speaker": "atc",
      "prompt": "You are lined up on runway {{runway}} for circuits. Read back the clearance.",
      "visual": {
        "kind": "pattern",
        "side": "{{runway.circuit}}",
        "position": "upwind",
        "runway": "{{runway}}"
      },
      "atcText": "{{callsign}}, {{tower}}, runway {{runway}}, cleared for take-off, {{runway.circuit}}-hand circuit, report downwind, wind {{wind}}.",
      "expectedPilotResponse": "Runway {{runway}}, cleared for take-off, {{runway.circuit}}-hand circuit, wilco, {{callsign}}.",
      "requiredElements": [
        {
          "id": "runway",
          "label": "Runway {{runway}}",
          "acceptedVariants": [
            "runway {{runway}}"
          ],
          "weight": 20,
          "critical": true
        },
        {
          "id": "cleared_take_off",
          "label": "Cleared for take-off",
          "acceptedVariants": [
            "cleared for take-off",
            "cleared for takeoff"
          ],
          "weight": 35,
          "critical": true
        },
        {
          "id": "circuit",
          "label": "Right-hand circuit",
          "acceptedVariants": [
            "{{runway.circuit}}-hand circuit",
            "{{runway.circuit}} hand circuit"
          ],
          "weight": 20
        },
        {
          "id": "wilco",
          "label": "Wilco",
          "acceptedVariants": [
            "wilco",
            "report downwind"
          ],
          "weight": 5
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 20,
          "critical": true
        }
      ],
      "criticalElements": [
        "runway",
        "cleared_take_off",
        "callsign"
      ]
    },
    {
      "id": "downwind",
      "type": "self_announce",
      "speaker": "pilot",
      "prompt": "You are on {{runway.circuit}} downwind. Report with your intention: touch-and-go.",
      "visual": {
        "kind": "pattern",
        "side": "{{runway.circuit}}",
        "position": "downwind",
        "runway": "{{runway}}"
      },
      "expectedPilotResponse": "{{callsign}}, {{runway.circuit}} downwind runway {{runway}}, touch-and-go.",
      "requiredElements": [
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 25
        },
        {
          "id": "downwind",
          "label": "Right downwind",
          "acceptedVariants": [
            "{{runway.circuit}} downwind",
            "downwind"
          ],
          "weight": 30
        },
        {
          "id": "runway",
          "label": "Runway {{runway}}",
          "acceptedVariants": [
            "runway {{runway}}"
          ],
          "weight": 20,
          "critical": true
        },
        {
          "id": "intention",
          "label": "Touch-and-go",
          "acceptedVariants": [
            "touch-and-go",
            "touch and go"
          ],
          "weight": 25
        }
      ],
      "criticalElements": [
        "runway"
      ]
    },
    {
      "id": "sequence-readback",
      "type": "pilot_readback",
      "speaker": "atc",
      "prompt": "Tower gives you your sequence. You can see the Cessna. Read back.",
      "visual": {
        "kind": "pattern",
        "side": "{{runway.circuit}}",
        "position": "downwind",
        "runway": "{{runway}}"
      },
      "atcText": "{{callsign}}, number two, follow the Cessna on base.",
      "expectedPilotResponse": "Number two, traffic in sight, {{callsign}}.",
      "requiredElements": [
        {
          "id": "number_two",
          "label": "Number two",
          "acceptedVariants": [
            "number two",
            "number 2"
          ],
          "weight": 40,
          "critical": true
        },
        {
          "id": "in_sight",
          "label": "Traffic in sight",
          "acceptedVariants": [
            "traffic in sight",
            "in sight"
          ],
          "weight": 30
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 30,
          "critical": true
        }
      ],
      "criticalElements": [
        "number_two",
        "callsign"
      ]
    },
    {
      "id": "touch-and-go-readback",
      "type": "pilot_readback",
      "speaker": "atc",
      "prompt": "On final, Tower clears you. Read back.",
      "visual": {
        "kind": "pattern",
        "side": "{{runway.circuit}}",
        "position": "final",
        "runway": "{{runway}}"
      },
      "atcText": "{{callsign}}, runway {{runway}}, cleared touch-and-go, wind {{wind}}.",
      "expectedPilotResponse": "Runway {{runway}}, cleared touch-and-go, {{callsign}}.",
      "requiredElements": [
        {
          "id": "runway",
          "label": "Runway {{runway}}",
          "acceptedVariants": [
            "runway {{runway}}"
          ],
          "weight": 30,
          "critical": true
        },
        {
          "id": "cleared_tgo",
          "label": "Cleared touch-and-go",
          "acceptedVariants": [
            "cleared touch-and-go",
            "cleared touch and go"
          ],
          "weight": 40,
          "critical": true
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 30,
          "critical": true
        }
      ],
      "criticalElements": [
        "runway",
        "cleared_tgo",
        "callsign"
      ]
    }
  ]
}
