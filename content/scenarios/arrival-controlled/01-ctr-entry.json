{
  "id": "arr-ctrl-ctr-entry",
  "title": "Control zone entry",
  "packId": "arrival-controlled",
  "variants": {
    "aerodromes": [
      "EPPO"
    ],
    "from": [
      "EPPI"
    ],
    "weather": true,
    "aircraft": true
  },
  "difficulty": "medium",
  "estimatedDurationSec": 150,
  "objective": "Make the initial call to Tower, read back the CTR entry clearance and report the entry point.",
  "briefing": [
    {
      "label": "Airport",
      "value": "{{airport}}"
    },
    {
      "label": "Station",
      "value": "{{tower}} {{tower.freq}}"
    },
    {
      "label": "Callsign",
      "value": "{{callsign}}"
    },
    {
      "label": "Aircraft",
      "value": "{{aircraft}}"
    },
    {
      "label": "Position",
      "value": "Approaching {{arrival.entry}}"
    },
    {
      "label": "Altitude",
      "value": "2000 feet"
    },
    {
      "label": "ATIS",
      "value": "Information {{atis}}"
    },
    {
      "label": "Wind",
      "value": "{{wind.brief}}"
    }
  ],
  "phraseologyNote": {
    "id": "ctr-entry",
    "title": "Entering a control zone",
    "shortExplanation": "You need a clearance to enter a CTR. Read back the entry point, altitude limits and reporting instructions.",
    "overview": [
      "A control zone (CTR) is controlled airspace from the surface up to a published upper limit around a controlled aerodrome. A VFR flight needs a clearance from Tower before it enters, so call well before the entry point.",
      "In the first contact use the full callsign of the station and of your aircraft. Give your position, altitude, the ATIS letter and your intention. Tower answers with an entry clearance: the VFR entry point, an altitude limit and the next point to report.",
      "An altitude limit is a level instruction, so it must always be read back. Say \"altitude\" with the value and never \"to\" before a number. Report each point when you reach it."
    ],
    "whyItMatters": "Altitude limits keep VFR traffic clear of IFR arrivals.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "7.4 VFR arrivals"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.3 Issue of clearance and read-back requirements"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "3.3 Level instructions"
      },
      {
        "source": "AIP Polska",
        "section": "GEN 1.7 Differences from ICAO phraseology",
        "url": "https://ais.pansa.pl/publikacje/aip-polska/"
      },
      {
        "source": "{{chart.source}}",
        "section": "{{chart.section}}",
        "url": "{{chart.url}}"
      }
    ]
  },
  "steps": [
    {
      "id": "initial-call",
      "type": "pilot_request",
      "speaker": "pilot",
      "prompt": "You are approaching {{arrival.entry}}, {{arrival.entry.location}} of the control zone, at 2000 feet with ATIS {{atis}}. Call Tower: inbound for landing.",
      "expectedPilotResponse": "{{tower}}, {{callsign}}, approaching {{arrival.entry}}, altitude 2000 feet, information {{atis}}, inbound for landing.",
      "requiredElements": [
        {
          "id": "station",
          "label": "{{tower}}",
          "acceptedVariants": [
            "{{tower}}"
          ],
          "weight": 10
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 20
        },
        {
          "id": "position",
          "label": "Approaching {{arrival.entry}}",
          "acceptedVariants": [
            "approaching {{arrival.entry}}"
          ],
          "weight": 20
        },
        {
          "id": "altitude",
          "label": "Altitude 2000 feet",
          "acceptedVariants": [
            "[altitude] 2000 feet"
          ],
          "weight": 15
        },
        {
          "id": "atis",
          "label": "Information {{atis}}",
          "acceptedVariants": [
            "information {{atis}}"
          ],
          "weight": 15
        },
        {
          "id": "inbound",
          "label": "Inbound for landing",
          "acceptedVariants": [
            "inbound for landing"
          ],
          "weight": 20
        }
      ],
      "visual": {
        "kind": "airspace",
        "point": "{{arrival.entry}}",
        "direction": "inbound"
      }
    },
    {
      "id": "entry-readback",
      "type": "pilot_readback",
      "speaker": "atc",
      "prompt": "Read back the CTR entry clearance.",
      "atcText": "{{callsign}}, {{tower}}, enter control zone via {{arrival.entry}}, not above altitude {{arrival.altitude}} feet, report {{arrival.report}}.",
      "expectedPilotResponse": "Enter control zone via {{arrival.entry}}, not above altitude {{arrival.altitude}} feet, report {{arrival.report}}, {{callsign}}.",
      "requiredElements": [
        {
          "id": "enter",
          "label": "Enter control zone via {{arrival.entry}}",
          "acceptedVariants": [
            "enter control zone via {{arrival.entry}}",
            "entering control zone via {{arrival.entry}}"
          ],
          "weight": 30,
          "critical": true
        },
        {
          "id": "altitude",
          "label": "Not above altitude {{arrival.altitude}} feet",
          "acceptedVariants": [
            "not above [altitude] {{arrival.altitude}} feet"
          ],
          "weight": 30,
          "critical": true
        },
        {
          "id": "report",
          "label": "Report {{arrival.report}}",
          "acceptedVariants": [
            "report {{arrival.report}}",
            "will report {{arrival.report}}",
            "wilco"
          ],
          "weight": 20
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 20,
          "critical": true
        }
      ],
      "criticalElements": [
        "enter",
        "altitude",
        "callsign"
      ],
      "visual": {
        "kind": "airspace",
        "point": "{{arrival.entry}}",
        "direction": "inbound"
      }
    },
    {
      "id": "report-victor",
      "type": "self_announce",
      "speaker": "pilot",
      "prompt": "You are over {{arrival.report}} at {{arrival.altitude}} feet. Report.",
      "expectedPilotResponse": "{{callsign}}, {{arrival.report}}, altitude {{arrival.altitude}} feet.",
      "requiredElements": [
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 30
        },
        {
          "id": "november",
          "label": "{{arrival.report}}",
          "acceptedVariants": [
            "{{arrival.report}}",
            "over {{arrival.report}}",
            "overhead {{arrival.report}}"
          ],
          "weight": 40
        },
        {
          "id": "altitude",
          "label": "Altitude {{arrival.altitude}} feet",
          "acceptedVariants": [
            "[altitude] {{arrival.altitude}} feet"
          ],
          "weight": 30
        }
      ],
      "visual": {
        "kind": "airspace",
        "point": "{{arrival.report}}",
        "direction": "inbound"
      }
    }
  ]
}
