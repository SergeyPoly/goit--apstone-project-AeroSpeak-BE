{
  "id": "arr-unc-inbound",
  "title": "Inbound call",
  "packId": "arrival-uncontrolled",
  "variants": {
    "aerodromes": [
      "EPPI"
    ],
    "from": [
      "EPPO"
    ],
    "weather": true,
    "aircraft": true
  },
  "difficulty": "easy",
  "estimatedDurationSec": 120,
  "objective": "Call the A/G radio station inbound, read back the airfield information and announce joining.",
  "briefing": [
    {
      "label": "Airport",
      "value": "{{airport}}"
    },
    {
      "label": "Station",
      "value": "{{radio}} {{radio.freq}}"
    },
    {
      "label": "Callsign",
      "value": "{{callsign}}"
    },
    {
      "label": "Aircraft",
      "value": "{{aircraft}}"
    },
    {
      "label": "Position",
      "value": "{{arrival.entry}}"
    },
    {
      "label": "Altitude",
      "value": "2000 feet"
    },
    {
      "label": "Intention",
      "value": "Full-stop landing"
    },
    {
      "label": "Wind",
      "value": "{{wind.brief}}"
    }
  ],
  "phraseologyNote": {
    "id": "ag-inbound",
    "title": "Arriving at an A/G aerodrome",
    "shortExplanation": "{{radio}} gives information, not clearances. Call inbound early and decide how you join.",
    "overview": [
      "{{city}} has an air/ground radio station, called \"Radio\". The operator passes the runway in use, the circuit direction, the QNH and known traffic, but does not control traffic. You decide how to join and announce what you do.",
      "Make the inbound call well before the aerodrome: station, callsign, position, altitude, intention and the request for airfield information.",
      "Read back the runway in use and the QNH: both are always read back. Then announce where you join the circuit so other pilots on the frequency know where you are."
    ],
    "whyItMatters": "With no controller, separation depends on every pilot hearing and reporting positions.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.1 Establishment and continuation of communication"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.3 Issue of clearance and read-back requirements"
      },
      {
        "source": "{{chart.source}}",
        "section": "{{chart.section}}",
        "url": "{{chart.url}}"
      }
    ]
  },
  "steps": [
    {
      "id": "inbound",
      "type": "pilot_request",
      "speaker": "pilot",
      "prompt": "You are over {{arrival.entry}}, {{arrival.entry.location}} of {{city}}, at 2000 feet, inbound for landing. Call {{radio}} and ask for airfield information.",
      "expectedPilotResponse": "{{radio}}, {{callsign}}, overhead {{arrival.entry}}, altitude 2000 feet, inbound for landing, request airfield information.",
      "requiredElements": [
        {
          "id": "station",
          "label": "{{radio}}",
          "acceptedVariants": [
            "{{radio}}"
          ],
          "weight": 10
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 20
        },
        {
          "id": "position",
          "label": "Overhead {{arrival.entry}}",
          "acceptedVariants": [
            "overhead {{arrival.entry}}",
            "over {{arrival.entry}}"
          ],
          "weight": 15
        },
        {
          "id": "altitude",
          "label": "Altitude 2000 feet",
          "acceptedVariants": [
            "[altitude] 2000 feet"
          ],
          "weight": 10
        },
        {
          "id": "inbound",
          "label": "Inbound for landing",
          "acceptedVariants": [
            "inbound for landing",
            "inbound"
          ],
          "weight": 25
        },
        {
          "id": "request",
          "label": "Request airfield information",
          "acceptedVariants": [
            "request airfield information",
            "request information"
          ],
          "weight": 20
        }
      ],
      "visual": {
        "kind": "airspace",
        "point": "{{arrival.entry}}",
        "direction": "inbound"
      }
    },
    {
      "id": "information-readback",
      "type": "pilot_readback",
      "speaker": "atc",
      "prompt": "Read back runway and QNH.",
      "atcText": "{{callsign}}, {{radio}}, runway {{runway}} in use, {{runway.circuit}}-hand circuit, QNH {{qnh}}, one Cessna in the circuit, wind {{wind}}.",
      "expectedPilotResponse": "Runway {{runway}}, QNH {{qnh}}, {{callsign}}.",
      "requiredElements": [
        {
          "id": "runway",
          "label": "Runway {{runway}}",
          "acceptedVariants": [
            "runway {{runway}}"
          ],
          "weight": 30,
          "critical": true
        },
        {
          "id": "qnh",
          "label": "QNH {{qnh}}",
          "acceptedVariants": [
            "QNH {{qnh}}"
          ],
          "weight": 40,
          "critical": true
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 30,
          "critical": true
        }
      ],
      "criticalElements": [
        "runway",
        "qnh",
        "callsign"
      ],
      "visual": {
        "kind": "airspace",
        "point": "{{arrival.entry}}",
        "direction": "inbound"
      }
    },
    {
      "id": "joining",
      "type": "self_announce",
      "speaker": "pilot",
      "prompt": "Announce joining {{runway.circuit}} downwind for runway {{runway}}.",
      "expectedPilotResponse": "{{radio}}, {{callsign}}, joining {{runway.circuit}} downwind runway {{runway}}.",
      "requiredElements": [
