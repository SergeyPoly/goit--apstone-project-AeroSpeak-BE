{
  "id": "ground-ctrl-start-up",
  "title": "Start-up request",
  "packId": "ground-controlled",
  "variants": {
    "aerodromes": [
      "EPPO"
    ],
    "weather": true,
    "aircraft": true
  },
  "difficulty": "easy",
  "estimatedDurationSec": 90,
  "objective": "Request start-up from Ground with full identification and read back the approval.",
  "briefing": [
    {
      "label": "Airport",
      "value": "{{airport}}"
    },
    {
      "label": "Station",
      "value": "{{ground}} {{ground.freq}}"
    },
    {
      "label": "Callsign",
      "value": "{{callsign}}"
    },
    {
      "label": "Aircraft",
      "value": "{{aircraft}}"
    },
    {
      "label": "Position",
      "value": "General aviation apron"
    },
    {
      "label": "ATIS",
      "value": "Information {{atis}}"
    },
    {
      "label": "QNH",
      "value": "{{qnh}}"
    },
    {
      "label": "Wind",
      "value": "{{wind.brief}}"
    }
  ],
  "phraseologyNote": {
    "id": "initial-call",
    "title": "Initial call",
    "shortExplanation": "First contact: station, callsign, position, request, ATIS letter.",
    "overview": [
      "Your first call on a frequency uses the full callsign of the station and of your aircraft.",
      "Give your position, your request and the ATIS letter. With the ATIS acknowledged, the controller does not need to read out the departure information.",
      "Read back the QNH that comes with the start-up approval: altimeter settings are always read back."
    ],
    "whyItMatters": "ATC gets everything it needs in one call and confirms you have the current ATIS.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.1 Establishment and continuation of communication"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "4.2 Departure information and engine starting procedures"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.3 Issue of clearance and read-back requirements"
      }
    ]
  },
  "steps": [
    {
      "id": "request-start-up",
      "type": "pilot_request",
      "speaker": "pilot",
      "prompt": "You are parked at the general aviation apron with ATIS {{atis}}. Request start-up from Ground.",
      "expectedPilotResponse": "{{ground}}, {{callsign}}, at general aviation apron, request start-up, information {{atis}}.",
      "requiredElements": [
        {
          "id": "station",
          "label": "{{ground}}",
          "acceptedVariants": [
            "{{ground}}"
          ],
          "weight": 10
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 20
        },
        {
          "id": "position",
          "label": "At general aviation apron",
          "acceptedVariants": [
            "at general aviation apron",
            "general aviation apron",
            "at GA apron",
            "GA apron"
          ],
          "weight": 25
        },
        {
          "id": "request",
          "label": "Request start-up",
          "acceptedVariants": [
            "request start-up",
            "request startup"
          ],
          "weight": 25
        },
        {
          "id": "atis",
          "label": "Information {{atis}}",
          "acceptedVariants": [
            "information {{atis}}"
          ],
          "weight": 20
        }
      ]
    },
    {
      "id": "start-up-readback",
      "type": "pilot_readback",
      "speaker": "atc",
      "prompt": "Ground approves the start-up. Read it back.",
      "atcText": "{{callsign}}, {{ground}}, start-up approved, QNH {{qnh}}.",
      "expectedPilotResponse": "Start-up approved, QNH {{qnh}}, {{callsign}}.",
      "requiredElements": [
        {
          "id": "approved",
          "label": "Start-up approved",
          "acceptedVariants": [
            "start-up approved",
            "startup approved",
            "starting up"
          ],
          "weight": 30
        },
        {
          "id": "qnh",
          "label": "QNH {{qnh}}",
          "acceptedVariants": [
            "QNH {{qnh}}"
          ],
          "weight": 40,
          "critical": true
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 30,
          "critical": true
        }
      ],
      "criticalElements": [
        "qnh",
        "callsign"
      ]
    }
  ]
}
