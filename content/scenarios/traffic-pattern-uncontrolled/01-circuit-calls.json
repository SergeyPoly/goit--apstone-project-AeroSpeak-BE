{
  "id": "pattern-unc-circuit-calls",
  "title": "Circuit calls",
  "packId": "traffic-pattern-uncontrolled",
  "variants": {
    "aerodromes": [
      "EPPI"
    ],
    "weather": true,
    "aircraft": true
  },
  "difficulty": "easy",
  "estimatedDurationSec": 120,
  "objective": "Make the standard circuit position reports: downwind, base and final.",
  "briefing": [
    {
      "label": "Airport",
      "value": "{{airport}}"
    },
    {
      "label": "Station",
      "value": "{{radio}} {{radio.freq}}"
    },
    {
      "label": "Callsign",
      "value": "{{callsign}}"
    },
    {
      "label": "Aircraft",
      "value": "{{aircraft}}"
    },
    {
      "label": "Runway",
      "value": "{{runway}}"
    },
    {
      "label": "Wind",
      "value": "{{wind.brief}}"
    },
    {
      "label": "Intention",
      "value": "Touch-and-go"
    }
  ],
  "phraseologyNote": {
    "id": "circuit-calls",
    "title": "Circuit position reports",
    "shortExplanation": "Report downwind, base and final with the runway and your intention (touch-and-go or full stop).",
    "overview": [
      "Without a controller, position reports are how pilots see each other on the radio.",
      "Keep each report short: station, callsign, leg, runway and intention. Giving the intention on downwind and final helps the pilots behind you plan their spacing."
    ],
    "whyItMatters": "Other pilots in the circuit sequence themselves from your calls.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "4.6 Aerodrome traffic circuit"
      },
      {
        "source": "{{chart.source}}",
        "section": "{{chart.section}}",
        "url": "{{chart.url}}"
      }
    ]
  },
  "steps": [
    {
      "id": "downwind",
      "type": "self_announce",
      "speaker": "pilot",
      "prompt": "You are abeam the threshold on downwind. Report position and your intention: touch-and-go.",
      "visual": {
        "kind": "pattern",
        "side": "{{runway.circuit}}",
        "position": "downwind",
        "runway": "{{runway}}"
      },
      "expectedPilotResponse": "{{radio}}, {{callsign}}, {{runway.circuit}} downwind runway {{runway}}, touch-and-go.",
      "requiredElements": [
        {
          "id": "station",
          "label": "{{radio}}",
          "acceptedVariants": [
            "{{radio}}"
          ],
          "weight": 10
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 20
        },
        {
          "id": "downwind",
          "label": "Right downwind",
          "acceptedVariants": [
            "{{runway.circuit}} downwind",
            "downwind"
          ],
          "weight": 25
        },
        {
          "id": "runway",
          "label": "Runway {{runway}}",
          "acceptedVariants": [
            "runway {{runway}}"
          ],
          "weight": 20,
          "critical": true
        },
        {
          "id": "intention",
          "label": "Touch-and-go",
          "acceptedVariants": [
            "touch-and-go",
            "touch and go"
          ],
          "weight": 25
        }
      ],
      "criticalElements": [
        "runway"
      ]
    },
    {
      "id": "base",
      "type": "self_announce",
      "speaker": "pilot",
      "prompt": "You turned base. Report it.",
      "visual": {
        "kind": "pattern",
        "side": "{{runway.circuit}}",
        "position": "base",
        "runway": "{{runway}}"
      },
      "expectedPilotResponse": "{{radio}}, {{callsign}}, base runway {{runway}}.",
      "requiredElements": [
        {
          "id": "station",
          "label": "{{radio}}",
          "acceptedVariants": [
            "{{radio}}"
          ],
          "weight": 10
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 20
        },
        {
          "id": "base",
          "label": "Base",
          "acceptedVariants": [
            "base"
          ],
          "weight": 35
        },
        {
          "id": "runway",
          "label": "Runway {{runway}}",
          "acceptedVariants": [
            "runway {{runway}}"
          ],
          "weight": 35,
          "critical": true
        }
      ],
      "criticalElements": [
        "runway"
      ]
    },
    {
      "id": "final",
      "type": "self_announce",
      "speaker": "pilot",
      "prompt": "You are on final. Report with your intention.",
      "visual": {
        "kind": "pattern",
        "side": "{{runway.circuit}}",
        "position": "final",
        "runway": "{{runway}}"
      },
      "expectedPilotResponse": "{{radio}}, {{callsign}}, final runway {{runway}}, touch-and-go.",
      "requiredElements": [
