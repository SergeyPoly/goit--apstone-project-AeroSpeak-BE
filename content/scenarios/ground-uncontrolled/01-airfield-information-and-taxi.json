{
  "id": "ground-unc-information-taxi",
  "title": "Airfield information and taxi",
  "packId": "ground-uncontrolled",
  "variants": {
    "aerodromes": [
      "EPPI"
    ],
    "to": [
      "EPPO"
    ],
    "weather": true,
    "aircraft": true
  },
  "difficulty": "easy",
  "estimatedDurationSec": 120,
  "objective": "Ask the A/G radio station for airfield information, read back the essentials and announce your taxi.",
  "briefing": [
    {
      "label": "Airport",
      "value": "{{airport}}"
    },
    {
      "label": "Station",
      "value": "{{radio}} {{radio.freq}}"
    },
    {
      "label": "Callsign",
      "value": "{{callsign}}"
    },
    {
      "label": "Aircraft",
      "value": "{{aircraft}}"
    },
    {
      "label": "Position",
      "value": "Apron"
    },
    {
      "label": "Intention",
      "value": "VFR flight to {{departure.to}}"
    },
    {
      "label": "Wind",
      "value": "{{wind.brief}}"
    }
  ],
  "phraseologyNote": {
    "id": "ag-radio",
    "title": "A/G radio (Radio)",
    "shortExplanation": "An A/G station gives information, not clearances. You decide and announce what you do.",
    "overview": [
      "{{radio}} is an air/ground station: the operator passes the runway in use, wind, QNH and traffic, but cannot clear you.",
      "Ask for the airfield information, read back the runway and the QNH, then announce your taxi with the runway you taxi to."
    ],
    "whyItMatters": "Other traffic builds its picture from your announcements.",
    "references": [
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.1 Establishment and continuation of communication"
      },
      {
        "source": "ICAO Doc 9432 Manual of Radiotelephony",
        "section": "2.8.3 Issue of clearance and read-back requirements"
      },
      {
        "source": "{{chart.source}}",
        "section": "{{chart.section}}",
        "url": "{{chart.url}}"
      }
    ]
  },
  "steps": [
    {
      "id": "request-information",
      "type": "pilot_request",
      "speaker": "pilot",
      "prompt": "You are on the apron at {{city}}. Call {{radio}}: who you are, where you are, your flight, and ask for airfield information.",
      "expectedPilotResponse": "{{radio}}, {{callsign}}, on the apron, VFR flight to {{departure.to}}, request airfield information.",
      "requiredElements": [
        {
          "id": "station",
          "label": "{{radio}}",
          "acceptedVariants": [
            "{{radio}}"
          ],
          "weight": 11
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 22
        },
        {
          "id": "position",
          "label": "On the apron",
          "acceptedVariants": [
            "on the apron",
            "at the apron",
            "apron"
          ],
          "weight": 17
        },
        {
          "id": "flight",
          "label": "VFR flight to {{departure.to}}",
          "acceptedVariants": [
            "VFR flight to {{departure.to}}",
            "VFR to {{departure.to}}"
          ],
          "weight": 22
        },
        {
          "id": "request",
          "label": "Request airfield information",
          "acceptedVariants": [
            "request airfield information",
            "request information"
          ],
          "weight": 28
        }
      ]
    },
    {
      "id": "information-readback",
      "type": "pilot_readback",
      "speaker": "atc",
      "prompt": "{{radio}} gives you the runway in use and QNH. Read back runway and QNH.",
      "atcText": "{{callsign}}, {{radio}}, runway {{runway}} in use, {{runway.circuit}}-hand circuit, QNH {{qnh}}, wind {{wind}}.",
      "expectedPilotResponse": "Runway {{runway}}, QNH {{qnh}}, {{callsign}}.",
      "requiredElements": [
        {
          "id": "runway",
          "label": "Runway {{runway}}",
          "acceptedVariants": [
            "runway {{runway}}"
          ],
          "weight": 30,
          "critical": true
        },
        {
          "id": "qnh",
          "label": "QNH {{qnh}}",
          "acceptedVariants": [
            "QNH {{qnh}}"
          ],
          "weight": 40,
          "critical": true
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 30,
          "critical": true
        }
      ],
      "criticalElements": [
        "runway",
        "qnh",
        "callsign"
      ]
    },
    {
      "id": "taxiing",
      "type": "self_announce",
      "speaker": "pilot",
      "prompt": "Announce that you are taxiing to the holding point of the runway in use.",
      "expectedPilotResponse": "{{radio}}, {{callsign}}, taxiing to holding point runway {{runway}}.",
      "requiredElements": [
        {
          "id": "station",
          "label": "{{radio}}",
          "acceptedVariants": [
            "{{radio}}"
          ],
          "weight": 10
        },
        {
          "id": "callsign",
          "label": "{{callsign}}",
          "acceptedVariants": [
            "{{callsign}}"
          ],
          "weight": 20
        },
        {
          "id": "taxiing",
          "label": "Taxiing to holding point",
          "acceptedVariants": [
            "taxiing to holding point",
            "taxiing to the holding point",
            "taxi to holding point"
          ],
          "weight": 35
        },
        {
          "id": "runway",
          "label": "Runway {{runway}}",
          "acceptedVariants": [
            "runway {{runway}}"
          ],
          "weight": 35,
          "critical": true
        }
      ],
      "criticalElements": [
        "runway"
      ]
    }
  ]
}
